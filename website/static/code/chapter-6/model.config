<?xml version="1.0"?>
<model>
  <name>differential_drive_robot</name>
  <version>1.0</version>
  <sdf version="1.7">robot_model.sdf</sdf>

  <author>
    <name>Physical AI & Humanoid Robotics Textbook</name>
    <email>textbook@example.com</email>
  </author>

  <description>
    A differential drive robot model for Gazebo simulation.
    This model includes:
    - Differential drive base with two wheels and a caster
    - IMU sensor for orientation and acceleration
    - LiDAR sensor for obstacle detection
    - Camera for visual perception
    - ROS2 integration for control and communication
  </description>

  <depend>
    <model>ground_plane</model>
  </depend>

  <depend>
    <model>sun</model>
  </depend>
</model>